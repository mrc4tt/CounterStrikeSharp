# Copy to eng/.env and fill in. eng/.env is gitignored — never commit real secrets.
# Used by update-schema.ts (loaded via dotenv from the current working directory).
# In CI these map to repository Actions secrets, not env-scoped secrets.

# --- Game server RCON (dump_schema) ---
GS_HOST=your.node.fqdn
GS_PORT=27015
GS_PASS=your_rcon_password

# --- Pterodactyl SFTP (fetch server.json) ---
# Values from the panel's "SFTP Details" box.
# SFTP_HOST: node FQDN only — no sftp:// prefix, no port (script adds them).
# SFTP_PORT: Pterodactyl default is 2022.
# SFTP_USER: dot-form account.serverShortId (e.g. mikkel.a1b2c3d4).
# SFTP_PASS: your panel account password.
SFTP_HOST=your.node.fqdn
SFTP_PORT=2022
SFTP_USER=account.serverShortId
SFTP_PASS=your_panel_password
