# CounterStrikeSharp crash dump configuration.
#
# Source this from the launch wrapper BEFORE starting cs2, e.g.
#
#   . /path/to/addons/counterstrikesharp/tools/crashdumps.env
#   ./cs2 -dedicated +map de_dust2 ...
#
# Nothing here needs to be installed per server: createdump and
# libmscordaccore.so already ship inside the bundled .NET runtime, so these
# variables are the only thing standing between a crash and a readable stack.

# Write a dump when the runtime dies (unhandled managed exception, FailFast,
# a crash the CLR observes). Off by default in .NET.
export DOTNET_DbgEnableMiniDump=1

# 1=Mini, 2=Heap, 3=Triage, 4=Full.
#
# 2 is the useful default: it carries the managed heap, so `dumpheap`/`gcroot`
# work, without the multi-GB size of a Full dump of a CS2 server. Drop to 3 if
# disk is tight -- triage still gives you managed stacks.
export DOTNET_DbgMiniDumpType=2

# %p = pid, %t = unix timestamp. Same directory the native crash reports and
# last_state.txt are written to, so one incident leaves one folder to look in.
# Adjust the path if the game directory is elsewhere.
export DOTNET_DbgMiniDumpName="$PWD/game/csgo/dumps/cssharp-%p-%t.dmp"

# Identifies this server in crash reports. With many servers on one machine this
# is what turns "a server crashed" into "these four crashed, same signature".
# Defaults to the -port value when unset.
# export CSSHARP_SERVER_ID="dm-04"

# Verbose createdump logging to stdout. Off unless dumps are not appearing.
# export DOTNET_CreateDumpDiagnostics=1
