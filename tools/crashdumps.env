# OPTIONAL overrides for CounterStrikeSharp crash dumps.
#
# You do not need this file. Dumps are on by default: CounterStrikeSharp sets
# these variables on the process itself before booting the .NET runtime, which is
# the window in which the runtime reads them. Tuning normally happens in
# configs/core.json (CrashDumpsEnabled / CrashDumpType / CrashDumpRetention).
#
# Use this only to override a specific server from its launch wrapper. Everything
# set here wins: the plugin never overwrites a value that is already present.
#
#   . /path/to/addons/counterstrikesharp/tools/crashdumps.env
#   ./cs2 -dedicated +map de_dust2 ...

# Name this server in crash reports. Defaults to hostname:port, which is already
# unique across a fleet -- set this only when you want friendlier names.
# export CSSHARP_SERVER_ID="dm-04"

# 1=Mini, 2=Heap (default), 3=Triage, 4=Full.
# export DOTNET_DbgMiniDumpType=3

# Write dumps somewhere other than csgo/dumps.
# export DOTNET_DbgMiniDumpName="/var/crash/cssharp-%p-%t.dmp"

# Turn dumps off for one server without touching core.json.
# export DOTNET_DbgEnableMiniDump=0

# Verbose createdump logging, if dumps are not appearing.
# export DOTNET_CreateDumpDiagnostics=1
