<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeFrameworkVersion>10.0.3</RuntimeFrameworkVersion>
        <AspNetCoreRuntimeFrameworkVersion>10.0.3</AspNetCoreRuntimeFrameworkVersion>
        <!-- Major roll-forward lets net8.0-targeted plugin assemblies resolve and load on the bundled .NET 10 runtime -->
        <RollForward>Major</RollForward>
        <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!--
          No GC / JIT tuning here, by choice. The runtime's own defaults apply.

          There WAS a tuned block (Workstation+background GC, TieredPGO, ReadyToRun) plus
          a runtimeconfig.template.json carrying RetainVM / DynamicAdaptationMode /
          Gen0Size / QuickJitForLoops. Both were removed deliberately; upstream carries
          none of it either, so this now matches upstream. Anything worth re-adding can
          be A/B'd on a live server first with env vars, no rebuild needed:
            DOTNET_gcServer=1           # Server GC
            DOTNET_gcConcurrent=0       # disable background gen2
            DOTNET_GCgen0size=2000000   # hex bytes; larger gen0 => fewer gen0 pauses
            DOTNET_GCRetainVM=1         # keep freed segments mapped
            DOTNET_TieredPGO=1
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Package validation stays OFF (no NuGet baseline to compare against); the
             assembly check below is what guards the public API. -->
        <GenerateCompatibilitySuppressionFile>false</GenerateCompatibilitySuppressionFile>
        <EnablePackageValidation>false</EnablePackageValidation>
        <!-- CS1591: missing XML doc. CP0003: ApiCompat assembly version mismatch (expected vs the baseline). CS15xx/CS0419: cosmetic XML
             doc-comment param/cref mismatches (no runtime impact). Nullable (CS8xxx)
             warnings are deliberately NOT suppressed — they are the null-deref radar. -->
        <NoWarn>$(NoWarn);CS1591;CP0003;CS1573;CS1574;CS1572;CS1711;CS0419</NoWarn>
        <Nullable>enable</Nullable>
        <Authors>Miksen</Authors>
        <Description>Forked server side runtime assembly for CounterStrikeSharp</Description>
        <PackageProjectUrl>http://docs.cssharp.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/roflmuffin/CounterStrikeSharp</RepositoryUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <SourceControlInformationFeatureSupported>true</SourceControlInformationFeatureSupported>
        <WarningsAsErrors>CS0108,CS0114</WarningsAsErrors>
        <!-- <GenerateCompatibilitySuppressionFile>true</GenerateCompatibilitySuppressionFile> -->
    </PropertyGroup>
    <PropertyGroup>
        <!-- Assembly API-compat check against the last FORK release. A public member that
             disappears or changes shape breaks every plugin compiled against it at load
             (MissingFieldException / MissingMethodException), so it fails the build here
             instead. The old baseline was upstream's v202.dll, which this fork no longer
             matches (800+ stale suppressions); it is gone.
             - Intentional break: rebuild with -p:ApiCompatGenerateSuppressionFile=true and
               commit the CompatibilitySuppressions.xml it writes.
             - Schema sync: game-driven schema removals are recorded the same way by
               sync-schema.yaml, so they show up in the schema PR's diff.
             - Re-baseline after a release: replace ApiCompat/<ver>.dll with that release's
               addons/counterstrikesharp/api/CounterStrikeSharp.API.dll, point
               ApiCompatContractAssembly at it, delete CompatibilitySuppressions.xml.
             CP0003 (assembly version differs from the baseline) is in NoWarn. -->
        <ApiCompatValidateAssemblies>true</ApiCompatValidateAssemblies>
        <ApiCompatContractAssembly>.\ApiCompat\v1.0.410.dll</ApiCompatContractAssembly>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Modules\Commands\CommandInfo" />
        <None Remove="Modules\Disabled\**" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NativeTestsPlugin</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CounterStrikeSharp.API.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FastGenericNew" Version="3.3.1" />
        <PackageReference Include="McMaster.NETCore.Plugins" Version="1.4.0" />
        <PackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="10.0.103" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Scrutor" Version="4.2.2" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
        <PackageReference Include="Tomlyn" Version="0.19.0" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Generated\Schema\" />
        <Folder Include="Modules\Errors" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Modules\Disabled\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="Modules\Disabled\**" />
    </ItemGroup>
    <PropertyGroup />
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
        <Exec Command="git describe --long --always --exclude=* --abbrev=7" ConsoleToMSBuild="True" IgnoreExitCode="False">
            <Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput" />
        </Exec>
    </Target>
    <!--  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">-->
    <!--    <Exec Command="dotnet run &#45;&#45;project ../../tooling/CodeGen.Natives" />-->
    <!--  </Target>-->
</Project>
