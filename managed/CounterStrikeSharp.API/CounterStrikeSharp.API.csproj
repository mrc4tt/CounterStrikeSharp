<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeFrameworkVersion>10.0.3</RuntimeFrameworkVersion>
        <AspNetCoreRuntimeFrameworkVersion>10.0.3</AspNetCoreRuntimeFrameworkVersion>
        <!-- Major roll-forward lets net8.0-targeted plugin assemblies resolve and load on the bundled .NET 10 runtime -->
        <RollForward>Major</RollForward>
        <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!--
          GC / JIT tuning for high player counts. These flow into the generated
          CounterStrikeSharp.API.runtimeconfig.json, which is what the native host loads
          (src/scripting/dotnet_host.cpp -> hostfxr_initialize_for_runtime_config).

          Server GC: multiple heaps + background GC threads => far higher allocation
          throughput than the default Workstation GC when many events fire per tick.
          DATAS (default-on with Server GC in .NET 8+) adapts heap count to load so a box
          running several CS2 instances doesn't oversubscribe cores.

          TRADEOFF: Server GC favours throughput; individual GC pauses can be larger than
          Workstation+Concurrent, which can show up as p99 frame-time jitter. MEASURE frame
          time (not just CPU%) after enabling. To revert, set ServerGarbageCollection=false.
        -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Package/assembly API-compat validation is OFF. It compared this assembly
             against a frozen upstream baseline (ApiCompat/v202.dll); this hard fork has
             diverged by 1600+ members and the schema-sync workflow keeps adding/removing
             schema members on every run, so the check produced thousands of CP00xx errors
             and forced CompatibilitySuppressions.xml to be regenerated (churning the tree)
             on every build just to stay green. Validating against an obsolete upstream
             baseline provides no signal for a fork. To re-enable real API-stability
             checks, re-baseline ApiCompatContractAssembly to a recent FORK release and
             flip these back on. -->
        <GenerateCompatibilitySuppressionFile>false</GenerateCompatibilitySuppressionFile>
        <EnablePackageValidation>false</EnablePackageValidation>
        <!-- CS1591: missing XML doc. CP0003: ApiCompat. CS15xx/CS0419: cosmetic XML
             doc-comment param/cref mismatches (no runtime impact). Nullable (CS8xxx)
             warnings are deliberately NOT suppressed — they are the null-deref radar. -->
        <NoWarn>$(NoWarn);CS1591;CP0003;CS1573;CS1574;CS1572;CS1711;CS0419</NoWarn>
        <Nullable>enable</Nullable>
        <Authors>Miksen</Authors>
        <Description>Forked server side runtime assembly for CounterStrikeSharp</Description>
        <PackageProjectUrl>http://docs.cssharp.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/roflmuffin/CounterStrikeSharp</RepositoryUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <SourceControlInformationFeatureSupported>true</SourceControlInformationFeatureSupported>
        <WarningsAsErrors>CS0108,CS0114</WarningsAsErrors>
        <!-- <GenerateCompatibilitySuppressionFile>true</GenerateCompatibilitySuppressionFile> -->
    </PropertyGroup>
    <PropertyGroup>
        <!-- Disabled: see the package-validation note above. v202.dll is an upstream
             baseline this fork intentionally no longer matches. -->
        <ApiCompatValidateAssemblies>false</ApiCompatValidateAssemblies>
        <ApiCompatContractAssembly>.\ApiCompat\v202.dll</ApiCompatContractAssembly>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Modules\Commands\CommandInfo" />
        <None Remove="Modules\Disabled\**" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NativeTestsPlugin</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FastGenericNew" Version="3.3.1" />
        <PackageReference Include="McMaster.NETCore.Plugins" Version="1.4.0" />
        <PackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="10.0.103" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Scrutor" Version="4.2.2" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
        <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
        <PackageReference Include="Tomlyn" Version="0.19.0" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Generated\Schema\" />
        <Folder Include="Modules\Errors" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Modules\Disabled\**" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Remove="Modules\Disabled\**" />
    </ItemGroup>
    <PropertyGroup />
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
        <Exec Command="git describe --long --always --exclude=* --abbrev=7" ConsoleToMSBuild="True" IgnoreExitCode="False">
            <Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput" />
        </Exec>
    </Target>
    <!--  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">-->
    <!--    <Exec Command="dotnet run &#45;&#45;project ../../tooling/CodeGen.Natives" />-->
    <!--  </Target>-->
</Project>
